---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'Pedidos de Oração',
  description:
    'Envie sua intenção de oração. Rezamos por cada pedido recebido em nosso terço semanal e nas missas do apostolado.',
};
---

<PageLayout metadata={metadata}>
  <Hero>
    <Fragment slot="title">Pedidos de Oração</Fragment>
    <Fragment slot="subtitle">
      "Onde dois ou três estiverem reunidos em meu nome, ali estou eu no meio deles." (Mt 18,20) — Deixe sua intenção
      abaixo. Rezamos por cada pedido em nosso terço semanal.
    </Fragment>
  </Hero>

  <section class="mx-auto max-w-2xl px-4 pb-20 sm:px-6">
    <form
      id="form-oracao"
      class="flex flex-col gap-5 rounded-xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8 dark:border-slate-700 dark:bg-slate-900"
    >
      <div>
        <label for="nome" class="mb-1 block text-sm font-semibold text-heading">Nome</label>
        <input
          type="text"
          id="nome"
          name="nome"
          required
          maxlength="120"
          placeholder="Seu nome ou de quem receberá a oração"
          class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-page focus:border-primary focus:outline-none dark:border-slate-600"
        />
      </div>
      <div>
        <label for="cidade" class="mb-1 block text-sm font-semibold text-heading">Cidade</label>
        <input
          type="text"
          id="cidade"
          name="cidade"
          required
          maxlength="120"
          placeholder="Sua cidade"
          class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-page focus:border-primary focus:outline-none dark:border-slate-600"
        />
      </div>
      <div>
        <label for="intencao" class="mb-1 block text-sm font-semibold text-heading">Intenção</label>
        <textarea
          id="intencao"
          name="intencao"
          required
          rows="5"
          maxlength="2000"
          placeholder="Escreva sua intenção de oração..."
          class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-page focus:border-primary focus:outline-none dark:border-slate-600"
        ></textarea>
      </div>
      <button type="submit" class="btn-primary w-full">Enviar pedido de oração</button>
      <p id="form-status" class="hidden rounded-lg p-3 text-center text-sm font-medium"></p>
    </form>

    <p class="mt-6 text-center text-sm text-muted">
      Seus dados são usados apenas para as orações e jamais são compartilhados. Pedidos permanecem anônimos nas
      intenções comunitárias.
    </p>
  </section>
</PageLayout>

<script>
  import { savePedido } from '~/utils/pedidos';

  const form = document.getElementById('form-oracao') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const pedido = {
      nome: String(data.get('nome') || '').trim(),
      cidade: String(data.get('cidade') || '').trim(),
      intencao: String(data.get('intencao') || '').trim(),
      data: new Date().toISOString(),
      id: crypto.randomUUID(),
    };
    if (!pedido.nome || !pedido.cidade || !pedido.intencao) return;
    try {
      await savePedido(pedido);
      status.textContent = '🙏 Pedido recebido! Rezaremos por sua intenção.';
      status.className =
        'rounded-lg p-3 text-center text-sm font-medium bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300';
      form.reset();
    } catch {
      status.textContent = 'Não foi possível enviar agora. Tente novamente em instantes.';
      status.className =
        'rounded-lg p-3 text-center text-sm font-medium bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300';
    }
    status.classList.remove('hidden');
    setTimeout(() => status.classList.add('hidden'), 8000);
  });
</script>
