---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(30 58 95); /* azul marinho clássico */
    --aw-color-secondary: rgb(23 42 69); /* azul marinho profundo */
    --aw-color-accent: rgb(180 141 62); /* dourado/âmbar sacro */

    --aw-color-text-heading: rgb(23 42 69);
    --aw-color-text-default: rgb(31 41 55);
    --aw-color-text-muted: rgb(31 41 55 / 70%);
    --aw-color-bg-page: rgb(253 252 250); /* fundo off-white limpo p/ leitura */

    --aw-color-bg-page-dark: rgb(8 9 10);

    ::selection {
      background-color: rgb(180 141 62 / 40%);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(96 139 196); /* azul marinho claro p/ dark */
    --aw-color-secondary: rgb(180 141 62); /* dourado como secundário no dark */
    --aw-color-accent: rgb(212 175 100); /* âmbar suave */

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(13 20 33);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
